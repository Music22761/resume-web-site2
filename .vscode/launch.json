{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Resume (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--port", "5000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Export static site (freeze.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/freeze.py",
      "console": "integratedTerminal"
    }
  ]
}
